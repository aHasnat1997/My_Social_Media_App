# PostgreSQL
POSTGRES_DB=social_media_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Redis
REDIS_PASSWORD=redispassword

# Server
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# RustFS (S3-compatible self-hosted storage)
# Admin credentials for the RustFS container
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfspassword
# Bucket name to use
S3_BUCKET_NAME=media
# Region (can be any value for self-hosted)
S3_REGION=us-east-1
# Leave S3_ENDPOINT empty to use AWS S3 instead of RustFS
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
