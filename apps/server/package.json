{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@Social_Media_App/db": "workspace:*",
    "@Social_Media_App/env": "workspace:*",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "bullmq": "^5.80.8",
    "dotenv": "catalog:",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Social_Media_App/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/express": "^5.0.6",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  }
}
