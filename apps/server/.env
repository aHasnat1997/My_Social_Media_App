PORT=5000
CORS_ORIGIN=http://localhost:5173
# Log level - trace, debug, info, warn, error, or fatal
LOG_LEVEL=info
# Redis host for BullMQ job queue
REDIS_HOST=localhost
# Redis port for BullMQ job queue
REDIS_PORT=6379
# Redis password (optional, leave empty for local development)
REDIS_PASSWORD=redispassword
# Self-hosted Redis connection URL (ioredis) - e.g. redis://:password@localhost:6379
REDIS_URL=redis://:redispassword@localhost:6379
# AWS S3 region for S3 bucket (e.g., us-east-1, eu-west-1)
S3_REGION=us-east-1
# RustFS or S3 endpoint (leave empty for AWS S3)
S3_ENDPOINT=http://localhost:9000
# Access key (RustFS admin key or AWS access key)
S3_ACCESS_KEY_ID=rustfsadmin
# Secret key (RustFS secret or AWS secret)
S3_SECRET_ACCESS_KEY=rustfspassword
# Bucket name
S3_BUCKET_NAME=media
# Database connection URL for PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/Social_Media_App
